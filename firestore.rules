rules_version = '2';

// The dictionary app has no client-side Firebase usage — only the server's
// Admin SDK (in lib/firebase-admin.ts) reads/writes the "definitions" cache,
// which bypasses these rules entirely. Deny all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
